# ---------------------------------------------------------------------------
# Run mode (optional - default SNYK_API)
#   SNYK_API -> call the Snyk API to generate the SBOM(s) (uses the vars below)
#   SNYK_CLI -> upload an SBOM file you produced with the Snyk CLI; pass it via
#               the command line:  ./snyk-sbom-to-servicenow --sbom-file-path ./sbom.json
#               In CLI mode only the ServiceNow variables are required.
# ---------------------------------------------------------------------------
RUN_MODE='SNYK_API'

# ---------------------------------------------------------------------------
# Processing scope (optional - default SNYK_PROJECT; SNYK_API mode only)
# SNOW_APPLICATION_SCOPE controls how many Snyk projects a single run uploads
# to the one ServiceNow Business Application. Accepted values:
#   SNYK_PROJECT -> requires SNYK_ORG_ID, SNYK_TARGET_ID, SNYK_PROJECT_ID
#   SNYK_TARGET  -> requires SNYK_ORG_ID, SNYK_TARGET_ID (all projects in target)
#   SNYK_ORG     -> requires SNYK_ORG_ID (all projects in the organization)
# ---------------------------------------------------------------------------
SNOW_APPLICATION_SCOPE='SNYK_PROJECT'

# ---------------------------------------------------------------------------
# Snyk (required in SNYK_API mode; which are needed depends on the scope above)
# ---------------------------------------------------------------------------
SNYK_API_TOKEN='MY_SNYK_TOKEN'
SNYK_ORG_ID='MY_SNYK_ORG_ID'
SNYK_TARGET_ID='MY_SNYK_TARGET_ID'
SNYK_PROJECT_ID='MY_SNYK_PROJECT_ID'

# ---------------------------------------------------------------------------
# Snyk (optional - defaults shown)
# ---------------------------------------------------------------------------
SNYK_BASE_URL='https://api.snyk.io/rest'
SNYK_REST_API_VERSION='2026-03-25'
SNYK_SBOM_FORMAT='cyclonedx1.6+json'
# SNYK_PLATFORM_DOMAIN is informational only (not used for API calls).
SNYK_PLATFORM_DOMAIN='app.snyk.io'

# ---------------------------------------------------------------------------
# ServiceNow (required in every run mode)
# The SBOM is uploaded to:
#   POST https://<SNOW_INSTANCE_SUBDOMAIN>.service-now.com/api/sbom/core/upload
#        ?businessApplicationId=<SNOW_BUSINESS_APPLICATION_ID>&sbomSource=<SnykAPI|SnykCLI>
# ---------------------------------------------------------------------------
SNOW_INSTANCE_SUBDOMAIN='MY_SNOW_SUBDOMAIN'
SNOW_ACCESS_TOKEN='MY_SNOW_ACCESS_TOKEN'
SNOW_BUSINESS_APPLICATION_ID='MY_SNOW_BUSINESS_APPLICATION_ID'

# ---------------------------------------------------------------------------
# Operational (optional - defaults shown)
# DEBUG_LEVEL: ERROR | WARNING | INFO | DEBUG | TRACE
# API_DRY_RUN: when true (SNYK_API mode only), generate the SBOM but skip the
#              ServiceNow upload. Ignored in SNYK_CLI mode.
# ---------------------------------------------------------------------------
DEBUG_LEVEL='INFO'
API_DRY_RUN='false'
HTTP_TIMEOUT_SECONDS='60'

# ---------------------------------------------------------------------------
# TLS (optional)
# By default, certificates are verified against the OS system trust store
# (like curl). Set CA_BUNDLE to a PEM file to use a specific bundle, or set
# SSL_VERIFY=false to disable verification (NOT recommended).
# ---------------------------------------------------------------------------
# CA_BUNDLE='/path/to/corporate-ca-bundle.pem'
SSL_VERIFY='true'
